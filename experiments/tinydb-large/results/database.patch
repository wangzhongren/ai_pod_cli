     def __init__(self, *args, **kwargs) -> None:
         """
         Create a new instance of TinyDB.
-        """
+
+        Passing ``copy_on_read=True`` enables deep-copying of returned
+        documents for tables opened through this database. The option is
+        consumed here and is never forwarded to the storage class.
+
+        :param copy_on_read: If ``True``, newly opened tables return deep
+                             copies of documents from read operations.
+        """
+
+        # ``copy_on_read`` is a TinyDB-level option and must be removed before
+        # the remaining keyword arguments are handed to the storage class.
+        copy_on_read = kwargs.pop('copy_on_read', False)
 
         storage = kwargs.pop('storage', self.default_storage_class)
 
         # Prepare the storage
         self._storage: Storage = storage(*args, **kwargs)
+
+        # This value is used as the default for tables created later on.
+        self._copy_on_read_default = bool(copy_on_read)
 

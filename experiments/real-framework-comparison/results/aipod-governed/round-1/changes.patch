+"""Identity normalization for FlaskBB self-registration.
+
+Registration identities are normalized once at the validation boundary so
+that validators, failure handlers and persistence all observe the same
+values:
+
+* ``username`` loses leading/trailing whitespace while keeping its display
+  case (``"  Fred  "`` -> ``"Fred"``).
+* ``email`` loses leading/trailing whitespace and is lowercased
+  (``"  A@B.COM  "`` -> ``"a@b.com"``).
+
+Normalization never mutates the caller's frozen ``UserRegistrationInfo``: a
+replacement instance is only built when a field actually changes, so plugins
+that rely on the original object identity keep working. Password, language
+and group are copied unchanged.
+"""
+
+import typing as t
+from dataclasses import replace
+
+
+def normalize_username(username: t.Any) -> t.Any:
+    """Strip surrounding whitespace from a username, preserving its case."""
+    if isinstance(username, str):
+        return username.strip()
+    return username
+
+
+def normalize_email(email: t.Any) -> t.Any:
+    """Strip surrounding whitespace and lowercase an email address."""
+    if isinstance(email, str):
+        return email.strip().lower()
+    return email
+
+
+def lookup_key(value: t.Any) -> t.Any:
+    """Case-insensitive, whitespace-insensitive key for uniqueness lookups."""
+    if isinstance(value, str):
+        return value.strip().lower()
+    return value
+
+
+def normalize_identity(info: t.Any) -> t.Any:
+    """Return ``info`` with normalized username and email.
+
+    The original object is returned unchanged (same identity) when neither
+    field needs normalization.
+    """
+    username = normalize_username(getattr(info, "username", None))
+    email = normalize_email(getattr(info, "email", None))
+    if username == info.username and email == info.email:
+        return info
+    return replace(info, username=username, email=email)

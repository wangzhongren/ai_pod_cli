+"""Focused tests for the registered ``register_user`` pipeline.
+
+These call :func:`pipelines.registration.run` directly, binding the
+registration resources exactly like the host adapter does, so the pipeline's
+ordering and native exception propagation are checked without the HTTP layer.
+"""
+
+import pytest
+from pluggy import HookimplMarker
+
+from ai_pod_cli import PipelineContext
+
+from flaskbb.core.auth.registration import UserRegistrationInfo, UserValidator
+from flaskbb.core.exceptions import StopValidation, ValidationError
+from flaskbb.user.models import User
+
+from modules.models.registration import RegistrationEnvelope
+from modules.providers.public.registration import bind_registration
+
+from pipelines.registration import run
+
+pytestmark = pytest.mark.usefixtures("default_settings")
+
+hookimpl = HookimplMarker("flaskbb")
+
+
+def make_info(**overrides):
+    values = {
+        "username": "  Fred  ",
+        "password": "secret",
+        "email": "  Fred@Example.COM  ",
+        "language": "en",
+        "group": 4,
+    }
+    values.update(overrides)
+    return UserRegistrationInfo(**values)
+
+
+def make_ctx(info):
+    return PipelineContext(params={"envelope": RegistrationEnvelope(info=info)})
+
+
+def run_pipeline(info, plugin_manager, database):
+    ctx = make_ctx(info)
+    with bind_registration(plugin_manager, User, database):
+        result = run(ctx)
+    return result, ctx
+
+
+def plugin_with_validators(validators, failure_handler=None):
+    class Plugin:
+        @hookimpl
+        def flaskbb_gather_registration_validators(self):
+            return list(validators)
+
+        if failure_handler is not None:
+
+            @hookimpl
+            def flaskbb_registration_failure_handler(self, user_info, failures):
+                failure_handler(user_info, failures)
+
+    return Plugin()
+
+
+class RaisingValidator(UserValidator):
+    def validate(self, user_info):
+        raise ValidationError("username", "nope")
+
+
+def test_pipeline_persists_normalized_identity(
+    database, plugin_manager, default_groups
+):
+    result, _ = run_pipeline(make_info(), plugin_manager, database)
+
+    stored = User.query.filter(User.username == "Fred").one()
+    assert result["user"] is stored
+    assert stored.username == "Fred"
+    assert stored.email == "fred@example.com"
+    assert stored.language == "en"
+    assert stored.primary_group_id == 4
+    assert stored.password != "secret"
+
+
+def test_pipeline_stops_and_reports_failures(
+    database, plugin_manager, default_groups
+):
+    captured = {}
+
+    def handler(user_info, failures):
+        captured["username"] = user_info.username
+        captured["email"] = user_info.email
+        captured["failures"] = failures
+
+    plugin_manager.register(plugin_with_validators([RaisingValidator()], handler))
+
+    with pytest.raises(StopValidation):
+        run_pipeline(make_info(), plugin_manager, database)
+
+    assert captured["username"] == "Fred"
+    assert captured["email"] == "fred@example.com"
+    assert captured["failures"] == [("username", "nope")]
+    assert User.query.count() == 0
+
+
+def test_pipeline_preserves_identity_without_normalization(
+    database, plugin_manager, default_groups
+):
+    captured = {}
+
+    def handler(user_info, failures):
+        captured["info"] = user_info
+
+    plugin_manager.register(plugin_with_validators([RaisingValidator()], handler))
+
+    info = make_info(username="Fred", email="fred@example.com")
+    with pytest.raises(StopValidation):
+        run_pipeline(info, plugin_manager, database)
+
+    assert captured["info"] is info
+
+
+def test_pipeline_does_not_mutate_frozen_info(
+    database, plugin_manager, default_groups
+):
+    info = make_info()
+    run_pipeline(info, plugin_manager, database)
+
+    assert info.username == "  Fred  "
+    assert info.email == "  Fred@Example.COM  "
+
+
+def test_pipeline_propagates_unexpected_errors(
+    database, plugin_manager, default_groups
+):
+    class BoomValidator(UserValidator):
+        def validate(self, user_info):
+            raise RuntimeError("boom")
+
+    plugin_manager.register(plugin_with_validators([BoomValidator()]))
+
+    with pytest.raises(RuntimeError, match="boom"):
+        run_pipeline(make_info(), plugin_manager, database)

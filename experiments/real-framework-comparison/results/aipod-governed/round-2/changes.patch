lf):\n            return []\n\n        @impl\n        def flaskbb_registration_failure_handler(self, user_info, failures):\n            handle_failure(user_info, failures)\n\n    from flaskbb.core.auth.registration import UserValidator\n    from flaskbb.core.exceptions import ValidationError\n\n    class RaisingValidator(UserValidator):\n        def validate(self, user_info):\n            raise ValidationError(\"username\", \"nope\")\n\n    plugin_manager.register(Impls())\n    plugin_manager.register(_validator_only(RaisingValidator()))\n\n    service = RegistrationService(plugins=plugin_manager, users=User, db=database)\n\n    with pytest.raises(StopValidation):\n        service.register(registration_info())\n\n    assert captured[\"username\"] == \"Fred\"\n    assert captured[\"email\"] == \"fred@example.com\"\n\n\ndef _validator_only(validator):\n    impl = HookimplMarker(\"flaskbb\")\n\n    class Impl:\n        @impl\n        def flaskbb_gather_registration_validators(self):\n            return [validator]\n\n    return Impl()\n===PIPE===\n\"\"\"Focused tests for the registered ``register_user`` pipeline.\n\nThese call :func:`pipelines.registration.run` directly, binding the\nregistration resources exactly like the host adapter does, so the pipeline's\nordering and native exception propagation are checked without the HTTP layer.\n\"\"\"\n\nimport pytest\nfrom pluggy import HookimplMarker\n\nfrom ai_pod_cli import PipelineContext\n\nfrom flaskbb.core.auth.registration import UserRegistrationInfo, UserValidator\nfrom flaskbb.core.exceptions import StopValidation, ValidationError\nfrom flaskbb.user.models import User\n\nfrom modules.models.registration import RegistrationEnvelope\nfrom modules.providers.public.registration import bind_registration\n\nfrom pipelines.registration import run\n\npytestmark = pytest.mark.usefixtures(\"default_settings\")\n\nhookimpl = HookimplMarker(\"flaskbb\")\n\n\ndef make_info(**overrides):\n    values = {\n        \"username\": \"  Fred  \",\n        \"password\": \"secret\",\n        \"email\": \"  Fred@Example.COM  \",\n        \"language\": \"en\",\n        \"group\": 4,\n    }\n    values.update(overrides)\n    return UserRegistrationInfo(**values)\n\n\ndef make_ctx(info):\n    return PipelineContext(params={\"envelope\": RegistrationEnvelope(info=info)})\n\n\ndef run_pipeline(info, plugin_manager, database):\n    ctx = make_ctx(info)\n    with bind_registration(plugin_manager, User, database):\n        result = run(ctx)\n    return result, ctx\n\n\ndef plugin_with_validators(validators, failure_handler=None):\n    class Plugin:\n        @hookimpl\n        def flaskbb_gather_registration_validators(self):\n            return list(validators)\n\n        if failure_handler is not None:\n\n            @hookimpl\n            def flaskbb_registration_failure_handler(self, user_info, failures):\n                failure_handler(user_info, failures)\n\n    return Plugin()\n\n\nclass RaisingValidator(UserValidator):\n    def validate(self, user_info):\n        raise ValidationError(\"username\", \"nope\")\n\n\ndef test_pipeline_persists_normalized_identity(\n    database, plugin_manager, default_groups\n):\n    result, _ = run_pipeline(make_info(), plugin_manager, database)\n\n    stored = User.query.filter(User.username == \"Fred\").one()\n    assert result[\"user\"] is stored\n    assert stored.username == \"Fred\"\n    assert stored.email == \"fred@example.com\"\n    assert stored.language == \"en\"\n    assert stored.primary_group_id == 4\n    assert stored.password != \"secret\"\n\n\ndef test_pipeline_stops_and_reports_failures(\n    database, plugin_manager, default_groups\n):\n    captured = {}\n\n    def handler(user_info, failures):\n        captured[\"username\"] = user_info.username\n        captured[\"email\"] = user_info.email\n        captured[\"failures\"] = failures\n\n    plugin_manager.register(plugin_with_validators([RaisingValidator()], handler))\n\n    with pytest.raises(StopValidation):\n        run_pipeline(make_info(), plugin_manager, database)\n\n    assert captured[\"username\"] == \"Fred\"\n    assert captured[\"email\"] == \"fred@example.com\"\n    assert captured[\"failures\"] == [(\"username\", \"nope\")]\n    assert User.query.count() == 0\n\n\ndef test_pipeline_preserves_identity_without_normalization(\n    database, plugin_manager, default_groups\n):\n    captured = {}\n\n    def handler(user_info, failures):\n        captured[\"info\"] = user_info\n\n    plugin_manager.register(plugin_with_validators([RaisingValidator()], handler))\n\n    info = make_info(username=\"Fred\", email=\"fred@example.com\")\n    with pytest.raises(StopValidation):\n        run_pipeline(info, plugin_manager, database)\n\n    assert captured[\"info\"] is info\n\n\ndef test_pipeline_does_not_mutate_frozen_info(\n    database, plugin_manager, default_groups\n):\n    info = make_info()\n    run_pipeline(info, plugin_manager, database)\n\n    assert info.username == \"  Fred  \"\n    assert info.email == \"  Fred@Example.COM  \"\n\n\ndef test_pipeline_propagates_unexpected_errors(\n    database, plugin_manager, default_groups\n):\n    class BoomValidator(UserValidator):\n        def validate(self, user_info):\n            raise RuntimeError(\"boom\")\n\n    plugin_manager.register(plugin_with_validators([BoomValidator()]))\n\n    with pytest.raises(RuntimeError, match=\"boom\"):\n        run_pipeline(make_info(), plugin_manager, database)\n===CONFTEST===\nfrom tests.fixtures.app import *  # noqa\nfrom tests.fixtures.auth import *  # noqa\nfrom tests.fixtures.cli import *  # noqa\nfrom tests.fixtures.forum import *  # noqa\nfrom tests.fixtures.plugin import *  # noqa\nfrom tests.fixtures.user import *  # noqa\nfrom tests.fixtures.helpers import *  # noqa\n===GROUPS_FIX===\ntests/fixtures/app.py:6:from flaskbb.utils.populate import create_default_groups, create_default_settings\ntests/fixtures/app.py:30:    ``User.get_permissions`` and ``get_groups`` are
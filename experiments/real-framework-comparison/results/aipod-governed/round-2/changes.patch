+    with pytest.raises(StopValidation) as excinfo:
+        run_pipeline(make_info(group=9999), plugin_manager, database)
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    assert User.query.count() == 0

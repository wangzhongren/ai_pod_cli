+"""Primary group guard for FlaskBB self-registration.
+
+Self-registration may only target an existing, ordinary group. A requested
+primary group that does not exist (including ``None``) or that carries any of
+the privileged/penalized flags (``admin``, ``super_mod``, ``mod``, ``guest`` or
+``banned``) is rejected.
+
+Allowed groups are discovered from the current database state, so newly created
+ordinary groups are accepted and no group ids are hardcoded.
+"""
+
+import typing as t
+
+from flask_babelplus import gettext as _
+
+from flaskbb.user.models import Group
+
+#: Group flags that make a group unsuitable as a self-registration target.
+FORBIDDEN_GROUP_FLAGS = ("admin", "super_mod", "mod", "guest", "banned")
+
+
+def group_rejection_reason(group_id: t.Any) -> str | None:
+    """Return a rejection reason, or ``None`` when the group is allowed.
+
+    A group is allowed when it exists in the database and none of the
+    :data:`FORBIDDEN_GROUP_FLAGS` are set on it.
+    """
+    if group_id is None:
+        return _("Please select a valid group")
+
+    group = Group.get(Group.id == group_id)
+    if group is None:
+        return _("Please select a valid group")
+
+    if any(getattr(group, flag, False) for flag in FORBIDDEN_GROUP_FLAGS):
+        return _("Please select a valid group")
+
+    return None--- a/modules/services/impl/validate.py

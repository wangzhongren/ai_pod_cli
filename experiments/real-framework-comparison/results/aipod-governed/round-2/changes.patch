+"""Interface-level checks for the self-registration primary-group guard.
+
+These drive the delivered ``RegistrationAdapter`` (the entry re-exported as
+``flaskbb.auth.services.registration.RegistrationService``) so the guard is
+exercised through the registered ``register_user`` Pipeline route exactly as
+the FlaskBB registration view runs it.
+"""
+
+from pathlib import Path
+
+import pytest
+from pluggy import HookimplMarker
+
+from ai_pod_cli.interface import create_context, load_adapter, load_manifest
+from flaskbb.core.auth.registration import UserRegistrationInfo
+from flaskbb.core.exceptions import StopValidation
+from flaskbb.user.models import Group, User
+from modules.models.registration import RegistrationEnvelope
+
+pytestmark = pytest.mark.usefixtures("default_settings")
+
+PROJECT_ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = "registration"
+
+hookimpl = HookimplMarker("flaskbb")
+
+#: The default "Member" group id used by the FlaskBB registration view.
+MEMBER_GROUP_ID = 4
+
+#: Index (in ``default_groups``) of the default groups carrying each flag.
+FLAGGED_GROUP_INDEX = {
+    "admin": 0,
+    "super_mod": 1,
+    "mod": 2,
+    "banned": 4,
+    "guest": 5,
+}
+
+
+def make_info(**overrides):
+    values = {
+        "username": "Newcomer",
+        "password": "secret",
+        "email": "newcomer@example.com",
+        "language": "en",
+        "group": MEMBER_GROUP_ID,
+    }
+    values.update(overrides)
+    return UserRegistrationInfo(**values)
+
+
+def make_adapter(plugin_manager, database):
+    _, manifest = load_manifest(MANIFEST, PROJECT_ROOT)
+    adapter = load_adapter(manifest, PROJECT_ROOT)
+    adapter.plugins = plugin_manager
+    adapter.users = User
+    adapter.db = database
+    return adapter
+
+
+class Recorder:
+    """Registration plugin that records hook invocations."""
+
+    def __init__(self):
+        self.failures = []
+        self.post_processed = []
+
+    def plugin(self):
+        recorder = self
+
+        class Plugin:
+            @hookimpl
+            def flaskbb_gather_registration_validators(self):
+                return []
+
+            @hookimpl
+            def flaskbb_registration_failure_handler(self, user_info, failures):
+                recorder.failures.append((user_info, failures))
+
+            @hookimpl
+            def flaskbb_registration_post_processor(self, user):
+                recorder.post_processed.append(user)
+
+        return Plugin()
+
+
+def test_adapter_rejects_missing_group(database, plugin_manager, default_groups):
+    recorder = Recorder()
+    plugin_manager.register(recorder.plugin())
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        adapter.register(make_info(group=9999))
+
+    group_failures = [f for f in excinfo.value.reasons if f[0] == "group"]
+    assert len(group_failures) == 1
+    assert group_failures[0][1]
+    assert len(recorder.failures) == 1
+    assert recorder.failures[0][1] == excinfo.value.reasons
+    assert recorder.post_processed == []
+    assert User.query.count() == 0
+
+
+def test_adapter_rejects_none_group(database, plugin_manager, default_groups):
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        adapter.register(make_info(group=None))
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    assert User.query.count() == 0
+
+
+@pytest.mark.parametrize("flag", sorted(FLAGGED_GROUP_INDEX))
+def test_adapter_rejects_privileged_group(
+    flag, database, plugin_manager, default_groups
+):
+    group_id = default_groups[FLAGGED_GROUP_INDEX[flag]].id
+    recorder = Recorder()
+    plugin_manager.register(recorder.plugin())
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        adapter.register(make_info(group=group_id))
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    assert len(recorder.failures) == 1
+    assert recorder.post_processed == []
+    assert User.query.count() == 0
+
+
+def test_adapter_accepts_newly_created_ordinary_group(
+    database, plugin_manager, default_groups
+):
+    group = Group(name="Newcomers")
+    group.save()
+    adapter = make_adapter(plugin_manager, database)
+
+    user = adapter.register(make_info(group=group.id))
+
+    stored = User.query.filter(User.username == "Newcomer").one()
+    assert user is stored
+    assert stored.primary_group_id == group.id
+
+
+def test_adapter_guard_applies_without_registered_validators(
+    database, plugin_manager, default_groups
+):
+    # No plugin at all is registered: the guard must still reject.
+    adapter = make_adapter(plugin_manager, database)
+    _, manifest = load_manifest(MANIFEST, PROJECT_ROOT)
+
+    with pytest.raises(StopValidation) as excinfo:
+        adapter.start(
+            create_context(manifest, PROJECT_ROOT),
+            {"envelope": RegistrationEnvelope(info=make_info(group=9999))},
+        )
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    assert User.query.count() == 0

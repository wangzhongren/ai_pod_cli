+"""Interface-level checks for the registration failure-hook path.
+
+These drive the delivered ``RegistrationAdapter`` (the entry re-exported as
+``flaskbb.auth.services.registration.RegistrationService``) so the behavior is
+exercised through the registered ``register_user`` Pipeline route exactly as the
+FlaskBB registration view runs it. When registration validation fails the
+adapter must attempt the registration failure hook exactly once and still
+surface the original ``StopValidation`` even if that hook raises an ordinary
+``Exception``; a ``StopValidation`` raised directly by a validator must be
+preserved as the exact instance. No user is persisted and no post-processor runs
+on this path, and ``BaseException`` subclasses from the hook are not swallowed.
+"""
+
+from pathlib import Path
+
+import pytest
+from pluggy import HookimplMarker
+
+from ai_pod_cli.interface import load_adapter, load_manifest
+from flaskbb.core.auth.registration import UserRegistrationInfo, UserValidator
+from flaskbb.core.exceptions import StopValidation, ValidationError
+from flaskbb.user.models import User
+
+pytestmark = pytest.mark.usefixtures("default_settings")
+
+PROJECT_ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = "registration"
+
+hookimpl = HookimplMarker("flaskbb")
+
+
+def make_info(**overrides):
+    values = {
+        "username": "Fred",
+        "password": "secret",
+        "email": "fred@example.com",
+        "language": "en",
+        "group": 4,
+    }
+    values.update(overrides)
+    return UserRegistrationInfo(**values)
+
+
+def make_adapter(plugin_manager, database):
+    _, manifest = load_manifest(MANIFEST, PROJECT_ROOT)
+    adapter = load_adapter(manifest, PROJECT_ROOT)
+    adapter.plugins = plugin_manager
+    adapter.users = User
+    adapter.db = database
+    return adapter
+
+
+class RaisingValidator(UserValidator):
+    def validate(self, user_info):
+        raise ValidationError("username", "nope")
+
+
+class DirectStopValidator(UserValidator):
+    def __init__(self, error):
+        self.error = error
+
+    def validate(self, user_info):
+        raise self.error
+
+
+def make_plugin(validators, failure_handler=None, post_processor=None):
+    class Plugin:
+        @hookimpl
+        def flaskbb_gather_registration_validators(self):
+            return list(validators)
+
+        if failure_handler is not None:
+
+            @hookimpl
+            def flaskbb_registration_failure_handler(self, user_info, failures):
+                failure_handler(user_info, failures)
+
+        if post_processor is not None:
+
+            @hookimpl
+            def flaskbb_registration_post_processor(self, user):
+                post_processor(user)
+
+    return Plugin()
+
+
+def test_hook_exception_still_raises_original_stopvalidation(
+    database, plugin_manager, default_groups
+):
+    calls = []
+
+    def handler(user_info, failures):
+        calls.append(failures)
+        raise RuntimeError("hook blew up")
+
+    plugin_manager.register(make_plugin([RaisingValidator()], handler))
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        adapter.register(make_info())
+
+    assert excinfo.value.reasons == [("username", "nope")]
+    assert calls == [[("username", "nope")]]
+    assert User.query.count() == 0
+
+
+def test_direct_stopvalidation_instance_is_preserved(
+    database, plugin_manager, default_groups
+):
+    original = StopValidation([("email", "taken")])
+    calls = []
+
+    def handler(user_info, failures):
+        calls.append(failures)
+        raise RuntimeError("hook blew up")
+
+    plugin_manager.register(make_plugin([DirectStopValidator(original)], handler))
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        adapter.register(make_info())
+
+    assert excinfo.value is original
+    assert excinfo.value.reasons == [("email", "taken")]
+    assert calls == [[("email", "taken")]]
+    assert User.query.count() == 0
+
+
+def test_hook_attempted_exactly_once(database, plugin_manager, default_groups):
+    calls = []
+
+    def handler(user_info, failures):
+        calls.append(failures)
+        raise RuntimeError("hook blew up")
+
+    plugin_manager.register(make_plugin([RaisingValidator()], handler))
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation):
+        adapter.register(make_info())
+
+    assert len(calls) == 1
+
+
+def test_failure_path_skips_persistence_and_post_processors(
+    database, plugin_manager, default_groups
+):
+    post_calls = []
+
+    def handler(user_info, failures):
+        raise RuntimeError("hook blew up")
+
+    def post(user):
+        post_calls.append(user)
+
+    plugin_manager.register(
+        make_plugin([RaisingValidator()], handler, post)
+    )
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(StopValidation):
+        adapter.register(make_info())
+
+    assert post_calls == []
+    assert User.query.count() == 0
+
+
+def test_base_exception_from_hook_propagates(
+    database, plugin_manager, default_groups
+):
+    def handler(user_info, failures):
+        raise KeyboardInterrupt()
+
+    plugin_manager.register(make_plugin([RaisingValidator()], handler))
+    adapter = make_adapter(plugin_manager, database)
+
+    with pytest.raises(KeyboardInterrupt):
+        adapter.register(make_info())
+
+    assert User.query.count() == 0
+
+
+def test_successful_registration_still_runs_post_processors(
+    database, plugin_manager, default_groups
+):
+    post_calls = []
+
+    def post(user):
+        post_calls.append(user)
+
+    plugin_manager.register(make_plugin([], post_processor=post))
+    adapter = make_adapter(plugin_manager, database)
+
+    user = adapter.register(make_info())
+
+    assert post_calls == [user]
+    assert User.query.count() == 1

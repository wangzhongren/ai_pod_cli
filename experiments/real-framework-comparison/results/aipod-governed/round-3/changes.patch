-            "output": "tests/fixtures/app.py:52:def default_groups(database):\n===GROUPGUARD===\n\"\"\"Focused tests for the self-registration primary-group guard.\n\nThese drive the registered ``register_user`` pipeline with real registration\nresources bound, so the guard is exercised exactly as the host adapter runs it.\n\"\"\"\n\nimport pytest\nfrom pluggy import HookimplMarker\n\nfrom ai_pod_cli import PipelineContext\n\nfrom flaskbb.core.auth.registration import UserRegistrationInfo\nfrom flaskbb.core.exceptions import StopValidation\nfrom flaskbb.user.models import Group, User\n\nfrom modules.models.registration import RegistrationEnvelope\nfrom modules.providers.public.registration import bind_registration\n\nfrom pipelines.registration import run\n\npytestmark = pytest.mark.usefixtures(\"default_settings\")\n\nhookimpl = HookimplMarker(\"flaskbb\")\n\n#: The default \"Member\" group id used by the FlaskBB registration view.\nMEMBER_GROUP_ID = 4\n\n#: Index (in ``default_groups``) of the default groups carrying each flag.\nFLAGGED_GROUP_INDEX = {\n    \"admin\": 0,\n    \"super_mod\": 1,\n    \"mod\": 2,\n    \"banned\": 4,\n    \"guest\": 5,\n}\n\n\ndef make_info(**overrides):\n    values = {\n        \"username\": \"Newcomer\",\n        \"password\": \"secret\",\n        \"email\": \"newcomer@example.com\",\n        \"language\": \"en\",\n        \"group\": MEMBER_GROUP_ID,\n    }\n    values.update(overrides)\n    return UserRegistrationInfo(**values)\n\n\ndef run_pipeline(info, plugin_manager, database):\n    ctx = PipelineContext(params={\"envelope\": RegistrationEnvelope(info=info)})\n    with bind_registration(plugin_manager, User, database):\n        return run(ctx)\n\n\nclass Recorder:\n    \"\"\"Registration plugin that records hook invocations.\"\"\"\n\n    def __init__(self):\n        self.failures = []\n        self.post_processed = []\n\n    def plugin(self):\n        recorder = self\n\n        class Plugin:\n            @hookimpl\n            def flaskbb_gather_registration_validators(self):\n                return []\n\n            @hookimpl\n            def flaskbb_registration_failure_handler(self, user_info, failures):\n                recorder.failures.append((user_info, failures))\n\n            @hookimpl\n            def flaskbb_registration_post_processor(self, user):\n                recorder.post_processed.append(user)\n\n        return Plugin()\n\n\ndef test_rejects_missing_group(database, plugin_manager, default_groups):\n    recorder = Recorder()\n    plugin_manager.register(recorder.plugin())\n\n    with pytest.raises(StopValidation) as excinfo:\n        run_pipeline(make_info(group=9999), plugin_manager, database)\n\n    group_failures = [f for f in excinfo.value.reasons if f[0] == \"group\"]\n    assert len(group_failures) == 1\n    assert group_failures[0][1]\n    assert len(recorder.failures) == 1\n    assert recorder.failures[0][1] == excinfo.value.reasons\n    assert recorder.post_processed == []\n    assert User.query.count() == 0\n\n\ndef test_rejects_none_group(database, plugin_manager, default_groups):\n    with pytest.raises(StopValidation) as excinfo:\n        run_pipeline(make_info(group=None), plugin_manager, database)\n\n    assert any(attribute == \"group\" for attribute, _ in excinfo.value.reasons)\n    assert User.query.count() == 0\n\n\n@pytest.mark.parametrize(\"flag\", sorted(FLAGGED_GROUP_INDEX))\ndef test_rejects_privileged_group(flag, database, plugin_manager, default_groups):\n    group_id = default_groups[FLAGGED_GROUP_INDEX[flag]].id\n    recorder = Recorder()\n    plugin_manager.register(recorder.plugin())\n\n    with pytest.raises(StopValidation) as excinfo:\n        run_pipeline(make_info(group=group_id), plugin_manager, database)\n\n    assert any(attribute == \"group\" for attribute, _ in excinfo.value.reasons)\n    assert len(recorder.failures) == 1\n    assert recorder.post_processed == []\n    assert User.query.count() == 0\n\n\ndef test_accepts_default_member_group(database, plugin_manager, default_groups):\n    recorder = Recorder()\n    plugin_manager.register(recorder.plugin())\n\n    result = run_pipeline(make_info(group=MEMBER_GROUP_ID), plugin_manager, database)\n\n    stored = User.query.filter(User.username == \"Newcomer\").one()\n    assert result[\"user\"] is stored\n    assert stored.primary_group_id == MEMBER_GROUP_ID\n    assert recorder.failures == []\n    assert recorder.post_processed == [stored]\n\n\ndef test_accepts_newly_created_ordinary_group(database, plugin_manager, default_groups):\n    group = Group(name=\"Newcomers\")\n    group.save()\n\n    result = run_pipeline(make_info(group=group.id), plugin_manager, database)\n\n    assert result[\"user\"].primary_group_id == group.id\n\n\ndef test_guard_applies_without_registered_validators(\n    database, plugin_manager, default_groups\n):\n    # No plugin at all is registered: the guard must still reject.\n    with pytest.raises(StopValidation) as excinfo:\n        run_pipeline(make_info(group=9999), plugin_manager, database)\n\n    assert any(attribute == \"group\" for attribute, _ in excinfo.value.reasons)\n    assert User.query.count() == 0\n===ADAPTER-GUARD===\n\"\"\"Adapter-level checks for the self-registration primary-group guard.\n\nThe guard lives in the validation service, but it must also hold when the\nregistration is started through the host-compatible ``RegistrationService``\nadapter used by FlaskBB's registration view.\n\"\"\"\n\nimport pytest\nfrom pluggy import HookimplMarker\n\nfrom flaskbb.auth.services.registration import RegistrationService\nfrom flaskbb.core.auth.registration import UserRegistrationInfo\nfrom flaskbb.core.exceptions import StopValidation\nfrom flaskbb.user.models import User\n\npytestmark = pytest.mark.usefixtures(\"default_settings\")\n\nhookimpl = HookimplMarker(\"flaskbb\")\n\n\ndef make_info(**overrides):\n    values = {\n        \"username\": \"Newcomer\",\n        \"password\": \"secret\",\n        \"em
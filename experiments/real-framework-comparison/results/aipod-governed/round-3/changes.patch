-            "output": "docs/interfaces/registration.md\ninterfaces/__init__.py\ninterfaces/registration/__init__.py\ninterfaces/registration/adapter.py\ninterfaces/registration/interface.json\ntests/interfaces/test_registration_adapter.py\n---\n===== docs/interfaces/registration.md =====\n# Registration Interface\n\nEntry point for FlaskBB user self-registration. It is backed by the registered\n`register_user` Pipeline route and does not re-implement Service logic.\n\n## Adapter\n\n- Manifest: `interfaces/registration/interface.json` (name `registration`, kind `web`)\n- Adapter: `interfaces/registration/adapter.py`, class `RegistrationAdapter`\n- Routes: `register_user` (`pipelines/registration.py`)\n- Host compatibility: `flaskbb.auth.services.registration.RegistrationService`\n  re-exports this adapter, so FlaskBB's registration factory and views keep working.\n\n## No standalone launcher\n\nThis interface is hosted by FlaskBB. `start()` accepts a `RegistrationEnvelope`\nand runs the registered route; `register(user_info)` is the host-facing entry\nthat binds FlaskBB's plugin manager, `User` model and SQLAlchemy session, then\ndelegates to the same route. The adapter's `smoke_payloads()` returns a\nnon-destructive sample (`envelope: None`) used only for declaration checks.\n\n## Checks\n\nFrom the project root:\n\n```\npython -m ai_pod_cli interface --project-root . smoke registration\npython -m ai_pod_cli interface --project-root . run registration --payload '{\"envelope\": null}'\npython -m pytest -o addopts='' tests/interfaces/test_registration_adapter.py -q\npython -m pytest -o addopts='' tests -q\n```\n\nThe `run` CLI, like `start`, needs a FlaskBB application context and bound\nregistration resources, so end-to-end behavior is covered by\n`tests/interfaces/test_registration_adapter.py` and the host registration tests\nrather than by a standalone server process.\n===== interfaces/__init__.py =====\n===== interfaces/registration/__init__.py =====\n===== interfaces/registration/adapter.py =====\nfrom pathlib import Path\n\nfrom ai_pod_cli.interface import InterfaceAdapter, create_context, load_manifest\nfrom flaskbb.core.auth.registration import UserRegistrationService\nfrom modules.models.registration import RegistrationEnvelope\nfrom modules.providers.public.registration import bind_registration\n\n\nclass RegistrationAdapter(InterfaceAdapter, UserRegistrationService):\n    \"\"\"Interface entry for self-registration over the registered route.\n\n    ``start`` runs the frozen ``register_user`` pipeline route; ``register``\n    is the host-compatible adapter used by FlaskBB's registration factory.\n    \"\"\"\n\n    def __init__(self, plugins=None, users=None, db=None):\n        self.plugins, self.users, self.db = plugins, users, db\n\n    def required_routes(self):\n        return ['register_user']\n\n    def smoke_payloads(self):\n        return {'register_user': {'envelope': None}}\n\n    def start(self, context, payload=None):\n        params = payload or {}\n        if self.plugins is None:\n            return context.run_route('register_user', params)\n        with bind_registration(self.plugins, self.users, self.db):\n            return context.run_route('register_user', params)\n\n    def register(self, user_info):\n        root = Path(__file__).resolve().parents[2]\n        _, manifest = load_manifest('registration', root)\n        with bind_registration(self.plugins, self.users, self.db):\n            result = self.start(\n                create_context(manifest, root),\n                {'envelope': RegistrationEnvelope(info=user_info)},\n            )\n        return result['user']\n===== interfaces/registration/interface.json =====\n{\n  \"name\": \"registration\",\n  \"file\": \"interfaces/registration/interface.json\",\n  \"kind\": \"web\",\n  \"adapter\": {\n    \"path\": \"interfaces/registration/adapter.py\",\n    \"class_name\": \"RegistrationAdapter\"\n  },\n  \"artifacts\": [],\n  \"lifecycle\": {},\n  \"support\": {\n    \"standalone\": false,\n    \"host\": \"FlaskBB request/application context\"\n  },\n  \"verify\": [\n    \"{python}\",\n    \"-m\",\n    \"pytest\",\n    \"-o\",\n    \"addopts=\",\n    \"tests/interfaces/test_registration_adapter.py\",\n    \"-q\"\n  ]\n}\n===== tests/interfaces/test_registration_adapter.py =====\n\"\"\"Focused checks for the registered registration Interface entry.\"\"\"\n\nfrom pathlib import Path\n\nimport pytest\n\nfrom ai_pod_cli.interface import create_context, load_adapter, load_manifest\nfrom flaskbb.core.auth.registration import (\n    RegistrationFailureHandler,\n    UserRegistrationInfo,\n    UserValidator,\n)\nfrom flaskbb.core.exceptions import StopValidation, ValidationError\nfrom flaskbb.user.models import User\nfrom modules.models.registration import RegistrationEnvelope\nfrom pluggy import HookimplMarker\n\npytestmark = pytest.mark.usefixtures(\"default_settings\")\n\nPROJECT_ROOT = Path(__file__).resolve().parents[2]\nMANIFEST = \"registration\"\n\n\ndef _info(**overrides):\n    values = {\n        \"username\": \"  Fred  \",\n        \"password\": \"secret\",\n        \"email\": \"  Fred@Example.COM  \",\n        \"language\": \"en\",\n        \"group\": 4,\n    }\n    values.update(overrides)\n    return UserRegistrationInfo(**values)\n\n\ndef _adapter(plugin_manager, database):\n    _, manifest = load_manifest(MANIFEST, PROJECT_ROOT)\n    adapter = load_adapter(manifest, PROJECT_ROOT)\n    adapter.plugins = plugin_manager\n    adapter.users = User\n    adapter.db = database\n    return adapter\n\n\ndef test_manifest_and_smoke_report_passes():\n    manifest_path, manifest = load_manifest(MANIFEST, PROJECT_ROOT)\n    assert manifest_path.name == \"interface.json\"\n    adapter = load_adapter(manifest, PROJECT_ROOT)\n    context = create_context(manifest, PROJECT_ROOT)\n\n    report = adapter.smoke(context)\n\n    assert report[\"status\"] == \"passed\", report\n    assert report[\"required_routes\"] == [\"register_user\"]\n    assert context.route_names() == [\"register_user\"]\n\n\ndef test_start_runs_registered_route_without_standalone_service(\n    database, plugin_manager, default_groups\n):\n    _, manifest = load_manifest(MANIFEST, PROJECT_ROOT)\n    adapter = _adapter(plugin_manager, database)\n    context = create_context(manifest, PROJECT_ROOT)\n\n    result = adapter.start(\n        context, {\"envelope\": RegistrationEnvelope(info=_info())}\n    )\n\n    assert result[\"user\"].username == \"Fred\"\n    assert result[\"user\"].email == \"fred@example.com\"\n\n\ndef test_adapter_persists_normalized_identity(database, plugin_manager, default_groups):\n    adapter = _adapter(plugin_manager, database)\n\n    user = adapter.register(_info())\n\n    stored = User.query.filter(User.username == \"Fred\").one()\n    assert user.username == \"Fred\"\n    assert user.email == \"fred@example.com\"\n    assert stored.username == \"Fred\"\n    assert stored.email == \"fred@example.com\"\n    assert stored.password != \"secret\"\n    assert stored.language == \"en\"\n    assert stored.primary_group_id == 4\n\n\ndef test_adapter_does_not_mutate_frozen_info(database, plugin_manager, default_groups):\n    adapter = _adapter(plugin_manager, database)\n    info = _info()\n\n    adapter.register(info)\n\n    assert info.username == \"  Fred  \"\n    assert info.email == \"  Fred@Example.COM  \"\n\n\ndef test_adapter_failure_hook_sees_normalized_identity(\n    database, plugin_manager, default_groups\n):\n    captured = {}\n\n    impl = HookimplMarker(\"flaskbb\")\n\n    class RaisingValidator(UserValidator):\n        def validate(self, user_info):\n            raise ValidationError(\"username\", \"nope\")\n\n    class Impls:\n        @impl\n        def flaskbb_gather_registration_validators(self):\n            return [RaisingValidator()]\n\n        @impl\n        def flaskbb_registration_failure_handler(self, user_info, failures):\n            captured[\"username\"] = user_info.username\n            captured[\"email\"] = user_info.email\n            captured[\"failures\"] = failures\n\n    plugin_manager.register(Impls())\n    adapter = _adapter(plugin_manager, database)\n\n    with pytest.raises(StopValidation):\n        adapter.register(_info())\n\n    assert captured[\"username\"] == \"Fred\"\n    assert captured[\"email\"] == \"fred@example.com\"\n",

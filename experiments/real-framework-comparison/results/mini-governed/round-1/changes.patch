+def normalize_username(username: str) -> str:
+    """Trim surrounding whitespace while preserving the display case."""
+    return username.strip()
+
+
+def normalize_email(email: str) -> str:
+    """Trim surrounding whitespace and lowercase the email address."""
+    return email.strip().lower()
+
+
+def normalize_registration_info(info: UserRegistrationInfo) -> UserRegistrationInfo:
+    """Return ``info`` with normalized username/email.
+
+    The caller's frozen registration info is never mutated and the original
+    object is returned unchanged when no normalization is required so existing
+    plugins that compare identity continue to work.
+    """
+    username = normalize_username(info.username)
+    email = normalize_email(info.email)
+    if username == info.username and email == info.email:
+        return info
+    return replace(info, username=username, email=email)

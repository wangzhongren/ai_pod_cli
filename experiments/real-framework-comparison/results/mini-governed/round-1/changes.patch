--- a/tests/unit/auth/test_registration_normalization.py
+++ b/tests/unit/auth/test_registration_normalization.py
@@ -0,0 +1,211 @@
+import pytest
+from flaskbb.auth.services.registration import (
+    EmailUniquenessValidator,
+    RegistrationService,
+    UsernameUniquenessValidator,
+)
+from flaskbb.core.auth.registration import UserRegistrationInfo, UserValidator
+from flaskbb.core.exceptions import StopValidation, ValidationError
+from flaskbb.user.models import User
+from pluggy import HookimplMarker
+
+pytestmark = pytest.mark.usefixtures("default_settings")
+
+
+class RaisingValidator(UserValidator):
+    def validate(self, user_info):
+        raise ValidationError("username", "nope")
+
+
+class CapturingValidator(UserValidator):
+    def __init__(self):
+        self.seen = []
+
+    def validate(self, user_info):
+        self.seen.append(user_info)
+
+
+def _service(plugin_manager, database):
+    return RegistrationService(plugins=plugin_manager, users=User, db=database)
+
+
+def _info(**overrides):
+    values = {
+        "username": "  Fred  ",
+        "password": "secret",
+        "email": "  FRED@Example.COM  ",
+        "language": "de",
+        "group": 4,
+    }
+    values.update(overrides)
+    return UserRegistrationInfo(**values)
+
+
+def test_registration_stores_normalized_identity(database, plugin_manager, default_groups):
+    service = _service(plugin_manager, database)
+    info = _info()
+
+    user = service.register(info)
+
+    assert user.username == "Fred"
+    assert user.email == "fred@example.com"
+    assert user.language == "de"
+    assert user.primary_group_id == 4
+    assert user.check_password("secret")
+    # The caller's frozen info must not be mutated.
+    assert info.username == "  Fred  "
+    assert info.email == "  FRED@Example.COM  "
+    assert info.password == "secret"
+
+
+def test_validator_and_failure_hook_see_same_normalized_identity(
+    database, plugin_manager, default_groups
+):
+    seen = {}
+    validator = CapturingValidator()
+    impl = HookimplMarker("flaskbb")
+
+    class Impls:
+        @impl
+        def flaskbb_gather_registration_validators(self):
+            return [validator, RaisingValidator()]
+
+        @impl
+        def flaskbb_registration_failure_handler(self, user_info, failures):
+            seen["failure"] = user_info
+
+    plugin_manager.register(Impls())
+    service = _service(plugin_manager, database)
+
+    with pytest.raises(StopValidation):
+        service.register(_info())
+
+    assert seen["failure"] is validator.seen[0]
+    assert seen["failure"].username == "Fred"
+    assert seen["failure"].email == "fred@example.com"
+
+
+def test_identity_preserved_when_no_normalization_needed(database, plugin_manager):
+    seen = {}
+    impl = HookimplMarker("flaskbb")
+
+    class Impls:
+        @impl
+        def flaskbb_gather_registration_validators(self):
+            return [RaisingValidator()]
+
+        @impl
+        def flaskbb_registration_failure_handler(self, user_info, failures):
+            seen["failure"] = user_info
+
+    plugin_manager.register(Impls())
+    service = _service(plugin_manager, database)
+    info = UserRegistrationInfo(
+        username="Fred",
+        password="secret",
+        email="fred@example.com",
+        language="de",
+        group=4,
+    )
+
+    with pytest.raises(StopValidation):
+        service.register(info)
+
+    assert seen["failure"] is info
+
+
+def test_username_uniqueness_rejects_case_variant_and_whitespace(Fred):
+    validator = UsernameUniquenessValidator(User)
+    registration = UserRegistrationInfo(
+        username="  fReD  ",
+        email="other@example.com",
+        language="en",
+        group=4,
+        password="secret",
+    )
+
+    with pytest.raises(ValidationError) as excinfo:
+        validator(registration)
+
+    assert excinfo.value.attribute == "username"
+
+
+def test_email_uniqueness_rejects_case_variant_and_whitespace(Fred):
+    validator = EmailUniquenessValidator(User)
+    registration = UserRegistrationInfo(
+        username="brandnew",
+        email="  FRED@FRED.FRED  ",
+        language="en",
+        group=4,
+        password="secret",
+    )
+
+    with pytest.raises(ValidationError) as excinfo:
+        validator(registration)
+
+    assert excinfo.value.attribute == "email"
+
+
+def test_adapter_passes_normalized_info_to_registered_route(monkeypatch):
+    from interfaces.registration.adapter import RegistrationAdapter
+
+    captured = {}
+
+    def fake_start(self, context, payload=None):
+        captured["info"] = payload["envelope"].info
+        return {"user": "stub"}
+
+    monkeypatch.setattr(RegistrationAdapter, "start", fake_start)
+    adapter = RegistrationAdapter()
+    info = _info()
+
+    assert adapter.register(info) == "stub"
+    assert captured["info"] is not info
+    assert captured["info"].username == "Fred"
+    assert captured["info"].email == "fred@example.com"
+    # The caller's info is untouched.
+    assert info.username == "  Fred  "
+    assert info.email == "  FRED@Example.COM  "
+
+
+def test_adapter_preserves_identity_when_already_normalized(monkeypatch):
+    from interfaces.registration.adapter import RegistrationAdapter
+
+    captured = {}
+
+    def fake_start(self, context, payload=None):
+        captured["info"] = payload["envelope"].info
+        return {"user": "stub"}
+
+    monkeypatch.setattr(RegistrationAdapter, "start", fake_start)
+    adapter = RegistrationAdapter()
+    info = UserRegistrationInfo(
+        username="Fred",
+        password="secret",
+        email="fred@example.com",
+        language="de",
+        group=4,
+    )
+
+    adapter.register(info)
+
+    assert captured["info"] is info
+
+
+def test_pipeline_normalizes_when_invoked_directly(
+    database, plugin_manager, default_groups
+):
+    from ai_pod_cli import PipelineContext
+    from modules.models.registration import RegistrationEnvelope
+    from modules.providers.public.registration import bind_registration
+    from pipelines.registration import run
+
+    info = _info()
+    ctx = PipelineContext(params={"envelope": RegistrationEnvelope(info=info)})
+
+    with bind_registration(plugin_manager, User, database):
+        result = run(ctx)
+
+    assert result["user"].username == "Fred"
+    assert result["user"].email == "fred@example.com"
+    assert info.username == "  Fred  "

+import pytest
+from flaskbb.auth.services.registration import RegistrationService
+from flaskbb.core.auth.registration import (
+    RegistrationFailureHandler,
+    RegistrationPostProcessor,
+    UserRegistrationInfo,
+)
+from flaskbb.core.exceptions import StopValidation
+from flaskbb.user.models import Group, User
+from pluggy import HookimplMarker
+
+pytestmark = pytest.mark.usefixtures("default_settings")
+
+
+def _info(group):
+    return UserRegistrationInfo(
+        username="brandnew",
+        password="secret",
+        email="brandnew@example.com",
+        language="en",
+        group=group,
+    )
+
+
+def _service(plugin_manager, database):
+    return RegistrationService(plugins=plugin_manager, users=User, db=database)
+
+
+def _hooks(validator=None, failure=None, post_process=None):
+    impl = HookimplMarker("flaskbb")
+
+    class Impls:
+        if validator is not None:
+
+            @impl
+            def flaskbb_gather_registration_validators(self):
+                return [validator]
+
+        if failure is not None:
+
+            @impl
+            def flaskbb_registration_failure_handler(self, user_info, failures):
+                failure(user_info, failures)
+
+        if post_process is not None:
+
+            @impl
+            def flaskbb_registration_post_processor(self, user):
+                post_process(user)
+
+    return Impls()
+
+
+def _count_users():
+    return User.query.count()
+
+
+@pytest.mark.parametrize(
+    "index",
+    [0, 1, 2, 4, 5],
+    ids=["admin", "super_mod", "mod", "banned", "guest"],
+)
+def test_rejects_flagged_groups_without_plugin_validators(
+    database, plugin_manager, default_groups, mocker, index
+):
+    failure = mocker.MagicMock(spec=RegistrationFailureHandler)
+    post_process = mocker.MagicMock(spec=RegistrationPostProcessor)
+    plugin_manager.register(_hooks(failure=failure, post_process=post_process))
+    service = _service(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        service.register(_info(default_groups[index].id))
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    failure.assert_called_once()
+    post_process.assert_not_called()
+    assert _count_users() == 0
+
+
+def test_rejects_missing_group(database, plugin_manager, default_groups):
+    service = _service(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        service.register(_info(999999))
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    assert _count_users() == 0
+
+
+def test_rejects_none_group(database, plugin_manager, default_groups):
+    service = _service(plugin_manager, database)
+
+    with pytest.raises(StopValidation) as excinfo:
+        service.register(_info(None))
+
+    assert any(attribute == "group" for attribute, _ in excinfo.value.reasons)
+    assert _count_users() == 0
+
+
+def test_accepts_existing_ordinary_group(database, plugin_manager, default_groups):
+    service = _service(plugin_manager, database)
+
+    user = service.register(_info(default_groups[3].id))
+
+    assert user.id is not None
+    assert user.primary_group_id == default_groups[3].id
+
+
+def test_accepts_newly_created_ordinary_group(database, plugin_manager, default_groups):
+    ordinary = Group(name="Ordinary")
+    ordinary.save()
+    service = _service(plugin_manager, database)
+
+    user = service.register(_info(ordinary.id))
+
+    assert user.id is not None
+    assert user.primary_group_id == ordinary.id
+
+
+def test_failure_hook_called_once_for_group_rejection(database, plugin_manager, default_groups, mocker):
+    failure = mocker.MagicMock(spec=RegistrationFailureHandler)
+    plugin_manager.register(_hooks(failure=failure))
+    service = _service(plugin_manager, database)
+
+    with pytest.raises(StopValidation):
+        service.register(_info(default_groups[0].id))
+
+    failure.assert_called_once()

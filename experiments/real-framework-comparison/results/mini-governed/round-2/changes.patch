 from modules.providers.public.registration import RegistrationResources
+
+_RESTRICTED_GROUP_FLAGS = ("admin", "super_mod", "mod", "guest", "banned")
+
+
+class PrimaryGroupValidator(UserValidator):
+    """Ensure the requested primary group is safe for self-registration.
+
+    A requested group is rejected when it does not exist (``None`` included)
+    or when any of its current database type flags
+    (``admin``/``super_mod``/``mod``/``guest``/``banned``) is set.  Ordinary
+    groups with all five flags false are accepted even if they were created
+    after startup; no group ids are hardcoded.
+    """
+
+    def __init__(self, groups, db):
+        self.groups = groups
+        self.db = db
+
+    @t.override
+    def validate(self, user_info: UserRegistrationInfo):
+        group_id = getattr(user_info, "group", None)
+        group = None
+        if group_id is not None:
+            try:
+                group = self.db.session.get(self.groups, group_id)
+            except Exception:
+                group = None
+
+        is_restricted = any(
+            bool(getattr(group, flag, False)) for flag in _RESTRICTED_GROUP_FLAGS
+        )
+        if group is None or is_restricted:
+            raise ValidationError(
+                "group",
+                _("The selected group is not available for registration."),
+            )
+
 

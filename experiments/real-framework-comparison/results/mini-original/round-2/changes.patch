+class PrimaryGroupValidator(UserValidator):
+    """Validates that the requested primary group may be self-registered.
+
+    A group is acceptable when it exists in the database and none of its
+    ``admin``, ``super_mod``, ``mod``, ``guest`` or ``banned`` flags are set.
+    Any other existing group, including newly created ordinary groups, is
+    accepted; the group is looked up dynamically so no identifiers are
+    hardcoded.
+    """
+
+    restricted_flags = ("admin", "super_mod", "mod", "guest", "banned")
+
+    def __init__(self, groups: type[Group]):
+        self.groups = groups
+
+    @t.override
+    def validate(self, user_info: UserRegistrationInfo):
+        group_id = user_info.group
+        group = None
+        if isinstance(group_id, int) and not isinstance(group_id, bool):
+            group = db.session.get(self.groups, group_id)
+
+        if group is None or any(
+            getattr(group, flag) for flag in self.restricted_flags
+        ):
+            raise ValidationError(
+                "group",
+                _("The selected group is not allowed for registration"),
             )
 
 

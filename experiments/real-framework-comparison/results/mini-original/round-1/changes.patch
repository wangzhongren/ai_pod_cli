+def normalize_registration_info(
+    user_info: UserRegistrationInfo,
+) -> UserRegistrationInfo:
+    """Return registration information with normalized identities.
+
+    Leading and trailing whitespace is removed from both the username and the
+    email; the username keeps its display casing while the email is lowercased.
+    The password, language and group are passed through unchanged.
+
+    The original object is returned untouched when no field requires
+    normalization, so plugins that rely on object identity keep working.
+    """
+    username = user_info.username.strip()
+    email = user_info.email.strip().lower()
+
+    if username == user_info.username and email == user_info.email:
+        return user_info
+
+    return UserRegistrationInfo(
+        username=username,
+        password=user_info.password,
+        email=email,
+        language=user_info.language,
+        group=user_info.group,
+    )
 
 

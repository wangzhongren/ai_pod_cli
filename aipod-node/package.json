{
  "name": "aipod-node",
  "version": "0.1.0",
  "private": true,
  "description": "Governed compositional runtime and construction agent for Node.js applications",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aipod-node": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "examples/**/aipod.json",
    "examples/**/README.md",
    "examples/**/src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
